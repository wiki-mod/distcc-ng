#!/bin/sh
# What: Creates the system distcc group/user before the package's files
#   land.
# Why: --home /nonexistent (not Alpine's real distcc package's own
#   --home /dev/null) matches this fork's own maintainer decision,
#   already used by its RPM/deb packaging, for a service user with no
#   real need of a home directory.
# From: Issue #398

addgroup -S distcc 2>/dev/null
adduser -S -D -H -h /nonexistent -s /sbin/nologin -G distcc -g distcc distcc 2>/dev/null

exit 0
